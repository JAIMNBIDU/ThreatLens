# ─── API keys (get your own; never commit the real .env) ──────────────────────
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=

# ─── CORS: comma-separated allowlist of frontend origins (NO wildcard) ─────────
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# ─── Cache / persistence ──────────────────────────────────────────────────────
DB_PATH=/data/threatlens.db
CACHE_TTL_HOURS=24
FEODO_REFRESH_HOURS=6

# ─── Limits ───────────────────────────────────────────────────────────────────
MAX_IOCS=50
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60
ENRICH_CONCURRENCY=5

# ─── Set ENABLE_DOCS=false to hide /docs and /openapi.json in production ───────
ENABLE_DOCS=true
